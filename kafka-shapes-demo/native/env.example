# ============================================================
# Copy this file to .env and fill in the paths below.
# .env is gitignored and never committed.
# ============================================================

# Path to your RTI Connext DDS Professional installation.
NDDSHOME=/home/<you>/rti_connext_dds-7.7.0

# Path to the 'install' directory produced by building rticonnextdds-gateway.
RTI_GATEWAY_HOME=/home/<you>/rticonnextdds-gateway/install

# Path to your local Kafka installation (the extracted tarball directory).
KAFKA_DIR=/home/<you>/Downloads/kafka_2.13-4.1.1

# Target architecture string used by RTI (default shown below).
CONNEXTDDS_ARCH=x64Linux4gcc8.5.0

# Kafka bootstrap server address (default is fine for a local single-node broker).
KAFKA_BOOTSTRAP=localhost:9092
