#  $(SOURCE_DIR)ShapeType_KeyPlugin.cxx $(SOURCE_DIR)ShapeType_Key.cxx \
#  $(SOURCE_DIR)ShapeType_Key.hpp $(SOURCE_DIR)ShapeType_KeyPlugin.hpp $(SOURCE_DIR)application.hpp : \
#		$(SOURCE_DIR)ShapeType_Key.idl
#	$(NDDSHOME)/bin/rtiddsgen $(SOURCE_DIR)ShapeType_Key.idl -replace -language C++11
#
# Here is how we create those subdirectories automatically.
%.dir : 
	@echo "Checking directory $*"
	@if [ ! -d $* ]; then \
		echo "Making directory $*"; \
		mkdir -p $* ; \
	fi;

